# Square API Credentials
# Get these from https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_APPLICATION_ID=your_square_application_id_here
SQUARE_LOCATION_ID=your_square_location_id_here

# Environment: 'sandbox' for testing, 'production' for live payments
SQUARE_ENVIRONMENT=sandbox

# Admin PIN for accessing the dashboard (change this!)
ADMIN_PIN=1234

# App URL (used for Square Web Payments SDK)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=your_square_application_id_here
NEXT_PUBLIC_SQUARE_LOCATION_ID=your_square_location_id_here
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
