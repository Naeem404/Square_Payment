# Square API Credentials - https://developer.squareup.com/apps
# Copy this file to .env.local and fill in your values
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# Environment: sandbox or production
SQUARE_ENVIRONMENT=

# Admin PIN for the dashboard
ADMIN_PIN=

# Same values as above - exposed to browser for Square Web SDK
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=
